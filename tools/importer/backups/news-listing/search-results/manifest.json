  "data": "index news → /en/home/news/query-index.json (helix-query.yaml); blocks fetch it at runtime",
  "code": [
    "blocks/featured-article",
    "blocks/article-list",
    "blocks/article-search",
    "blocks/article-results",
    "themes/news-search",
    "scripts/news.js (fetchNewsArticles, formatArticleDate, currentPagePath, createBlockElement)",
